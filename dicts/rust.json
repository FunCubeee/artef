{
  "language": "Rust",
  "extensions": [".rs"],
  "prefixes": {
    "fn": " name() {}",
    "pu": "b fn name() {}",
    "le": "t mut value = 0;",
    "co": "nst VALUE: i32 = 0;",
    "st": "ruct Name;",
    "en": "um Name { Value }",
    "im": "pl Name {}",
    "tr": "ait Name {}",
    "ma": "tch value { _ => {} }",
    "if": " let Some(value) = option {}",
    "fo": "r item in items.iter() {}",
    "wh": "ile condition {}",
    "lo": "op {}",
    "us": "e std::collections::HashMap;",
    "mo": "d module;",
    "re": "turn value;",
    "no": "ne",
    "so": "me(value)",
    "ok": "((),)?",
    "er": "r",
    "ve": "c![1, 2, 3]",
    "pr": "intln!(\"value = {}\", value);",
    "ep": "rintln!(\"error = {}\", error);",
    "un": "wrap()",
    "ex": "pect(\"message\")",
    "dw": "rite!",
    "de": "r",
    "se": "lf",
    "mu": "t",
    "as": "sert_eq!(left, right);"
  }
}
